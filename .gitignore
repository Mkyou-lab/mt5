# Create .gitignore in root of your project

# Dependencies
node_modules/
package-lock.json
yarn.lock

# Environment variables
.env
.env.local
.env.production
.env.development

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS Files
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo

# Build outputs
build/
dist/
.next/
out/

# Mobile
.expo/
.expo-shared/

# Testing
coverage/

# Misc
*.pem
